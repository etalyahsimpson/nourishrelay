# NourishRelay demo environment configuration — SYNTHETIC DATA ONLY.
# Copy to `.env` for local Docker Compose runs: `cp .env.example .env`
# These are demo-only values. On any non-demo deployment every value below
# marked `change-me` MUST be replaced with a unique, generated secret.

# --- PostgreSQL (demo-only credentials) ---
POSTGRES_DB=nourishrelay
POSTGRES_USER=nourishrelay
POSTGRES_PASSWORD=change-me-demo-only
# Direct connection string used by local scripts and tests.
DATABASE_URL=postgresql://nourishrelay:change-me-demo-only@localhost:5432/nourishrelay

# --- Redis (broker for Celery workers) ---
REDIS_URL=redis://localhost:6379/0

# --- Session signing ---
# REQUIRED unique random value on non-demo deployments. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-generate-a-long-random-value

# --- Public origins ---
# API origin as reachable from the browser (used for CORS when the web app
# talks to the API directly instead of through the built-in proxy).
API_PUBLIC_ORIGIN=http://localhost:8000
WEB_PUBLIC_ORIGIN=http://localhost:3000
# Browser-facing API base URL. `/api/v1` (default) routes through the web
# app's same-origin proxy; set to http://localhost:8000/api/v1 to bypass it.
NEXT_PUBLIC_API_URL=/api/v1

# --- Mode & logging ---
DEMO_MODE=true
LOG_LEVEL=INFO
